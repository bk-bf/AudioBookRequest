{#def
    user: DetailedUser,
    book: Audiobook,
    queue_items: list[DownloadQueueItem],
    path_ok: bool | None = None,
#}

{% set active = queue_items | selectattr("state.is_active") | list %}
<div id="book-status"
     class="flex flex-col gap-3"
     {% if active %}hx-get="{{ base_url }}/book/{{ book.asin }}/hx-status" hx-trigger="every 5s" hx-swap="outerHTML"{% endif %}>
    <div class="flex items-center gap-2">
        <h2 class="text-lg font-bold">
            Status
        </h2>
        {% if book.downloaded %}
            <span class="badge badge-success">Downloaded</span>
        {% elif active %}
            <span class="badge badge-info">Downloading</span>
        {% elif book.missing %}
            <span class="badge badge-warning"
                  title="Download failed or no sources — kept on the wishlist; retry manually anytime">Missing</span>
        {% else %}
            <span class="badge badge-ghost">Wanted</span>
        {% endif %}
    </div>
    {% if book.downloaded_path %}
        <div class="text-sm">
            <span class="opacity-60">Path:</span>
            <span class="font-mono break-all">{{ book.downloaded_path }}</span>
            {% if path_ok is true %}
                <span class="badge badge-success badge-xs align-middle"
                      title="Files present on disk">✓</span>
            {% elif path_ok is false %}
                <span class="badge badge-error badge-xs align-middle"
                      title="Nothing found at this path — files moved or deleted. Use Edit Path to relink.">files not found</span>
            {% endif %}
        </div>
    {% endif %}
    {% if queue_items %}
        <div class="overflow-x-auto">
            <table class="table table-sm">
                <thead>
                    <tr>
                        <th>
                            Release
                        </th>
                        <th>
                            Indexer
                        </th>
                        <th>
                            Size
                        </th>
                        <th>
                            State
                        </th>
                        <th>
                            Added
                        </th>
                        {% if user.is_admin() %}
                            <th>
                            </th>
                        {% endif %}
                    </tr>
                </thead>
                <tbody>
                    {% for item in queue_items %}
                        <tr>
                            <td class="max-w-60 truncate" title="{{ item.source_title }}">
                                {{ item.source_title }}
                            </td>
                            <td>
                                {{ item.indexer }}
                            </td>
                            <td>
                                {{ item.size_MB }} MB
                            </td>
                            <td>
                                {% if item.state.value.__eq__("downloading") %}
                                    <div class="flex items-center gap-2">
                                        <progress class="progress progress-primary w-20"
                                                  value="{{ item.progress_percent }}"
                                                  max="100"></progress>
                                        <span class="text-xs">{{ item.progress_percent }}%</span>
                                    </div>
                                {% elif item.state.value.__eq__("queued") %}
                                    <span class="badge badge-ghost">Queued</span>
                                {% elif item.state.value.__eq__("stalled") %}
                                    <span class="badge badge-warning">Stalled {{ item.progress_percent }}%</span>
                                {% elif item.state.value.__eq__("completed") %}
                                    <span class="badge badge-info">Importing…</span>
                                {% elif item.state.value.__eq__("imported") %}
                                    <span class="badge badge-success" title="{{ item.import_path }}">Imported</span>
                                {% elif item.state.value.__eq__("error") %}
                                    <span class="badge badge-error" title="{{ item.error }}">Failed</span>
                                {% endif %}
                            </td>
                            <td class="text-xs opacity-60">
                                {{ item.created_at.strftime("%Y-%m-%d %H:%M") }}
                            </td>
                            {% if user.is_admin() %}
                                <td>
                                    <button type="button"
                                            title="Delete this download"
                                            class="btn btn-square btn-ghost btn-sm text-error"
                                            onclick="delete_item_{{ loop.index }}.showModal()">
                                        <icons.Trash />
                                    </button>
                                    <dialog id="delete_item_{{ loop.index }}" class="modal">
                                        <div class="modal-box">
                                            <h3 class="text-lg font-bold">
                                                Delete this download?
                                            </h3>
                                            <p class="py-2 text-sm opacity-70 break-all">
                                                {{ item.source_title }}
                                                {% if item.import_path %}
                                                    <br />
                                                    <span class="font-mono text-xs">{{ item.import_path }}</span>
                                                {% endif %}
                                            </p>
                                            <form class="flex flex-col gap-3"
                                                  hx-post="{{ base_url }}/book/{{ book.asin }}/hx-delete-item/{{ item.id }}"
                                                  hx-disabled-elt="find button[type='submit']"
                                                  hx-swap="none">
                                                <label class="label cursor-pointer justify-start gap-2">
                                                    <input type="checkbox"
                                                           name="remove_torrent"
                                                           class="checkbox checkbox-sm"
                                                           checked />
                                                    <span class="label-text text-sm">Also remove torrent + data from qBittorrent</span>
                                                </label>
                                                <label class="label cursor-pointer justify-start gap-2">
                                                    <input type="checkbox"
                                                           name="remove_request"
                                                           class="checkbox checkbox-sm"
                                                           checked />
                                                    <span class="label-text text-sm">Also remove from wishlist (prevents automatic re-download)</span>
                                                </label>
                                                <button type="submit" class="btn btn-error btn-sm">
                                                    Delete
                                                </button>
                                            </form>
                                        </div>
                                        <form method="dialog" class="modal-backdrop">
                                            <button>
                                                close
                                            </button>
                                        </form>
                                    </dialog>
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <p class="text-sm opacity-60">
            No download activity yet.
        </p>
    {% endif %}
</div>

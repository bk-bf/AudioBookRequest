{#def
    user: DetailedUser,
    results: list,
    region: audible_region_type,
    total: int = 0,
    page: int = 0,
    has_next: bool = False,
    category_id: str = "",
    sort: str = "Relevance",
    keywords: str = "",
    auto_start_download: bool = False,
#}

<div class="flex items-center justify-between pb-2">
    <span class="text-sm opacity-60">{{ "{:,}".format(total) }} books · page {{ page + 1 }}</span>
    <div class="join">
        <button class="btn btn-sm join-item"
                {% if page.__eq__(0) %}disabled{% endif %}
                hx-get="{{ base_url }}/browse/hx-results?category_id={{ category_id }}&sort={{ sort }}&q={{ keywords }}&page={{ page - 1 }}"
                hx-target="#browse-results"
                hx-swap="innerHTML show:window:top">
            ❮ Prev
        </button>
        <button class="btn btn-sm join-item"
                {% if not has_next %}disabled{% endif %}
                hx-get="{{ base_url }}/browse/hx-results?category_id={{ category_id }}&sort={{ sort }}&q={{ keywords }}&page={{ page + 1 }}"
                hx-target="#browse-results"
                hx-swap="innerHTML show:window:top">
            Next ❯
        </button>
    </div>
</div>
{% if results %}
    <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-6 gap-x-4 gap-y-6">
        {% for result, rating_value, rating_count in results %}
            <div class="flex flex-col">
                <BookCard book_with_requests={{ result }} auto_start_download={{ auto_start_download }} region={{ region }} user={{ user }} />
                {% if rating_value %}
                    <div class="text-xs opacity-70 pt-1">
                        <span class="text-warning">★</span> {{ rating_value }}
                        {% if rating_count %}
                            ({{ "{:,}".format(rating_count) }})
                        {% endif %}
                    </div>
                {% endif %}
            </div>
        {% endfor %}
    </div>
{% else %}
    <div class="p-6 bg-base-200 rounded-md text-center text-sm opacity-70">
        No books found for this filter.
    </div>
{% endif %}

{#def
    user: DetailedUser,
    book: Audiobook,
    requests: list[AudiobookRequest],
    queue_items: list[DownloadQueueItem],
    region: audible_region_type,
    extended: ExtendedMetadata | None = None,
    abs_item_url: str | None = None,
    active_item: DownloadQueueItem | None = None,
#}

<BaseLayout title={{ book.title }} user={{ user }}>

<div class="flex items-start justify-center p-2 md:p-4">
    <main class="flex flex-col w-[95%] md:w-3/4 max-w-200 gap-6 pb-40">
        <div class="flex flex-col sm:flex-row gap-6">
            <div class="w-40 h-40 sm:w-56 sm:h-56 shrink-0 rounded-md overflow-hidden shadow shadow-black flex items-center justify-center">
                {% if book.cover_image %}
                    <img class="object-cover w-full h-full"
                         height="224"
                         width="224"
                         src="{{ book.cover_image }}"
                         alt="{{ book.title }}" />
                {% else %}
                    <div class="flex items-center justify-center w-full h-full bg-neutral opacity-30">
                        <icons.PhotoOff />
                    </div>
                {% endif %}
            </div>
            <div class="flex flex-col gap-1 min-w-0">
                <h1 class="text-2xl font-bold">
                    {{ book.title }}
                </h1>
                {% if book.subtitle %}
                    <h2 class="text-lg opacity-70">
                        {{ book.subtitle }}
                    </h2>
                {% endif %}
                {% if extended and extended.series_name %}
                    <div class="text-sm opacity-80">
                        <a preload
                           class="link link-hover"
                           href="{{ base_url }}/search?q={{ extended.series_name }}">{{ extended.series_name }}</a>
                        {% if extended.series_sequence %}
                            #{{ extended.series_sequence }}
                        {% endif %}
                    </div>
                {% endif %}
                {% if extended and extended.rating_value %}
                    <div class="text-sm">
                        <span class="text-warning">★</span>
                        <span class="font-semibold">{{ extended.rating_value }}</span>
                        {% if extended.rating_count %}
                            <span class="opacity-60">({{ "{:,}".format(extended.rating_count) }} ratings)</span>
                        {% endif %}
                    </div>
                {% endif %}
                <div class="text-sm pt-2">
                    <span class="opacity-60">Author:</span>
                    {% for author in book.authors %}
                        <a preload
                           class="link link-hover text-primary"
                           href="{{ base_url }}/search?q={{ author }}">{{ author }}</a>
                        {{- ", " if not loop.last else "" -}}
                    {% endfor %}
                </div>
                {% if book.narrators %}
                    <div class="text-sm">
                        <span class="opacity-60">Narrator:</span>
                        {{ book.narrators | join(", ") }}
                    </div>
                {% endif %}
                <div class="text-sm">
                    <span class="opacity-60">Released:</span>
                    {{ book.release_date.strftime("%B %d, %Y") }}
                </div>
                <div class="text-sm">
                    <span class="opacity-60">Runtime:</span>
                    {{ book.runtime_length_hrs }} hrs
                </div>
                {% if extended and extended.publisher_name %}
                    <div class="text-sm">
                        <span class="opacity-60">Publisher:</span>
                        {{ extended.publisher_name }}
                    </div>
                {% endif %}
                {% if extended and extended.language %}
                    <div class="text-sm">
                        <span class="opacity-60">Language:</span>
                        {{ extended.language }}
                    </div>
                {% endif %}
                {% if book.region %}
                    <div class="text-sm">
                        <span class="opacity-60">Region:</span>
                        <span class="uppercase">{{ book.region }}</span>
                    </div>
                {% endif %}
                <div class="text-sm">
                    <span class="opacity-60">Requested by:</span>
                    {% if requests %}
                        {{ requests | map(attribute="user_username") | join(", ") }}
                    {% else %}
                        nobody yet
                    {% endif %}
                </div>
                {% if extended and extended.genres %}
                    <div class="flex flex-wrap gap-1 pt-2">
                        {% for genre in extended.genres %}
                            <span class="badge badge-outline badge-sm">{{ genre }}</span>
                        {% endfor %}
                    </div>
                {% endif %}
                <div class="flex flex-wrap gap-2 pt-3">
                    {% set my_request = requests | selectattr("user_username", "equalto", user.username) | list %}
                    <button class="btn btn-sm {% if my_request %}btn-ghost{% else %}btn-info{% endif %}"
                            title="{% if my_request %}Remove from wishlist{% else %}Add to wishlist{% endif %}"
                            hx-post="{{ base_url }}/book/{{ book.asin }}/hx-toggle-request"
                            hx-disabled-elt="this"
                            hx-swap="none">
                        {% if my_request %}
                            <icons.Ban />
                            Unrequest
                        {% else %}
                            <icons.Plus />
                            Request
                        {% endif %}
                    </button>
                    {% if abs_item_url %}
                        <a class="btn btn-success btn-sm"
                           target="_blank"
                           rel="noopener"
                           href="{{ abs_item_url }}">
                            Listen in Audiobookshelf
                        </a>
                    {% endif %}
                    <Book.ActionButton user={{ user }} book={{ book }} active={{ active_item }} />
                    {% if user.is_admin() %}
                        <a preload
                           class="btn btn-sm"
                           href="{{ base_url }}/wishlist/sources/{{ book.asin }}">
                            <icons.List />
                            Browse Sources
                        </a>
                    {% endif %}
                    <a class="btn btn-sm"
                       target="_blank"
                       rel="noopener"
                       href="https://audible{{ audible_regions[region] }}/pd/{{ book.asin }}?ipRedirectOverride=true">
                        View on Audible
                    </a>
                    {% if user.is_admin() %}
                        <div class="dropdown dropdown-end">
                            <div tabindex="0" role="button" class="btn btn-sm">
                                Tag ▾
                            </div>
                            <ul tabindex="0"
                                class="dropdown-content menu bg-base-200 rounded-box z-50 w-44 p-2 shadow-xl">
                                <li>
                                    <button hx-post="{{ base_url }}/book/{{ book.asin }}/hx-set-status"
                                            hx-vals='{"status": "downloaded"}'
                                            hx-swap="none">
                                        <icons.Checkmark />
                                        Downloaded
                                    </button>
                                </li>
                                <li>
                                    <button hx-post="{{ base_url }}/book/{{ book.asin }}/hx-set-status"
                                            hx-vals='{"status": "missing"}'
                                            hx-swap="none">
                                        <icons.XMark />
                                        Missing
                                    </button>
                                </li>
                                <li>
                                    <button hx-post="{{ base_url }}/book/{{ book.asin }}/hx-set-status"
                                            hx-vals='{"status": "wanted"}'
                                            hx-swap="none">
                                        <icons.Download />
                                        Wanted
                                    </button>
                                </li>
                            </ul>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        {% if extended and extended.publisher_summary %}
            <div class="flex flex-col gap-2">
                <h2 class="text-lg font-bold">
                    Description
                </h2>
                <div class="text-sm leading-relaxed opacity-90 [&_p]:pb-2">
                    {{ extended.publisher_summary | safe }}
                </div>
            </div>
        {% endif %}

        <Book.Status user={{ user }} book={{ book }} queue_items={{ queue_items }} />

        <div hx-get="{{ base_url }}/book/{{ book.asin }}/hx-similar"
             hx-trigger="load"
             hx-swap="outerHTML">
        </div>
    </main>
</div>

</BaseLayout>

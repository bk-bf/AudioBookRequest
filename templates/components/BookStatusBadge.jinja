{#def
    downloaded: bool = False,
    missing: bool = False,
    queue: DownloadQueueItem | None = None,
    requesters: str = "",
    attempts: int = 0,
    max_attempts: int = 0,
#}

{% if queue %}
    {% if queue.state.value.__eq__("downloading") %}
        <div class="flex items-center gap-2" title="{{ queue.source_title }}">
            <progress class="progress progress-primary w-20"
                      value="{{ queue.progress_percent }}"
                      max="100"></progress>
            <span class="text-xs">{{ queue.progress_percent }}%</span>
        </div>
    {% elif queue.state.value.__eq__("queued") %}
        <span class="badge badge-ghost" title="{{ queue.source_title }}">Queued</span>
    {% elif queue.state.value.__eq__("stalled") %}
        <span class="badge badge-warning"
              title="Stalled at {{ queue.progress_percent }}% — {{ queue.source_title }}">Stalled {{ queue.progress_percent }}%</span>
    {% elif queue.state.value.__eq__("completed") %}
        <span class="badge badge-info" title="{{ queue.source_title }}">Importing…</span>
    {% elif queue.state.value.__eq__("imported") %}
        <span class="badge badge-success" title="{{ queue.import_path }}">Imported</span>
    {% elif queue.state.value.__eq__("error") %}
        {% if queue.rejected %}
            <span class="badge badge-error"
                  title="{{ queue.error }} — {{ queue.source_title }}">Rejected</span>
        {% else %}
            <span class="badge badge-error"
                  title="{{ queue.error }} — {{ queue.source_title }}">Failed</span>
        {% endif %}
        {% if max_attempts and not downloaded %}
            {% if attempts < max_attempts %}
                <span class="badge badge-ghost badge-sm"
                      title="A different release will be tried on the next sweep">retrying {{ attempts }}/{{ max_attempts }}</span>
            {% else %}
                <span class="badge badge-ghost badge-sm"
                      title="No automatic retries left — retry by hand from the book page">{{ attempts }}/{{ max_attempts }} tried</span>
            {% endif %}
        {% endif %}
    {% endif %}
{% elif downloaded %}
    <span class="badge badge-success">Downloaded</span>
{% elif missing %}
    <span class="badge badge-warning"
          title="{% if attempts %}{{ attempts }} release(s) tried, none worked{% else %}Download failed or no sources yet{% endif %}">
        Missing
        {% if attempts %}
            ({{ attempts }} tried)
        {% endif %}
    </span>
{% else %}
    <span class="text-xs opacity-40">—</span>
{% endif %}
{% if requesters and (downloaded or (queue and queue.state.value.__eq__("imported"))) %}
    <span class="badge badge-ghost badge-sm" title="Requested by">{{ requesters }}</span>
{% endif %}

{#def
    results: list[AudiobookWishlistResult],
    user: DetailedUser,
    counts: WishlistCounts,
    sort_by: str = "added",
    requested_by: str = "",
    usernames: list[str] = [],
#}

<WishlistLayout title="Wishlist" user={{ user }} counts={{ counts }} page="wishlist">
<div class="overflow-x-auto h-[75vh] border-b pb-2 border-b-base-200">
    <Wishlist.Wishlist results={{ results }} user={{ user }} page="wishlist" counts={{ counts }} sort_by={{ sort_by }} requested_by={{ requested_by }} usernames={{ usernames }} />
</div>
</WishlistLayout>

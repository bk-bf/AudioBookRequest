{#def
    slides: list,
    user: DetailedUser,
    region: audible_region_type,
    auto_start_download: bool = False,
#}

<div class="w-full max-w-7xl mb-8">
    <div id="hero-carousel"
         class="carousel w-full rounded-2xl shadow-xl scroll-smooth">
        {% for hero, extended in slides %}
            {% set book = hero.book %}
            <div id="hero-slide-{{ loop.index }}"
                 class="carousel-item relative w-full overflow-hidden min-h-64">
                {% if book.cover_image %}
                    <img class="absolute inset-0 w-full h-full object-cover blur-3xl opacity-40 scale-125"
                         src="{{ book.cover_image }}"
                         alt="" />
                {% endif %}
                <div class="absolute inset-0 bg-gradient-to-r from-base-100/90 via-base-100/60 to-base-100/30">
                </div>
                <div class="relative flex flex-col sm:flex-row gap-6 p-6 sm:p-10 items-start w-full">
                    <a preload
                       href="{{ base_url }}/book/{{ book.asin }}"
                       class="block w-36 h-36 sm:w-52 sm:h-52 shrink-0 rounded-xl overflow-hidden shadow-lg shadow-black/40">
                        {% if book.cover_image %}
                            <img class="object-cover w-full h-full"
                                 width="208"
                                 height="208"
                                 src="{{ book.cover_image }}"
                                 alt="{{ book.title }}" />
                        {% endif %}
                    </a>
                    <div class="flex flex-col gap-2 min-w-0">
                        <span class="text-xs uppercase tracking-widest opacity-60">Featured · {{ loop.index }}/{{ slides | length }}</span>
                        <a preload
                           href="{{ base_url }}/book/{{ book.asin }}"
                           class="text-2xl sm:text-4xl font-bold leading-tight line-clamp-2">{{ book.title }}</a>
                        <div class="text-sm opacity-80">
                            {{ book.authors | join(", ") }}
                            {% if book.runtime_length_hrs %}
                                · {{ book.runtime_length_hrs }}h
                            {% endif %}
                            {% if extended and extended.rating_value %}
                                · <span class="text-warning">★</span> {{ extended.rating_value }}
                            {% endif %}
                        </div>
                        {% if extended and extended.genres %}
                            <div class="flex flex-wrap gap-1">
                                {% for genre in extended.genres[:4] %}
                                    <span class="badge badge-outline badge-sm">{{ genre }}</span>
                                {% endfor %}
                            </div>
                        {% endif %}
                        {% if extended and extended.publisher_summary %}
                            <div class="text-sm opacity-80 line-clamp-3 max-w-2xl">
                                {{ extended.publisher_summary | striptags }}
                            </div>
                        {% endif %}
                        <div class="flex flex-wrap gap-2 pt-2 pb-6">
                            {% if book.downloaded %}
                                <span class="badge badge-success py-3">In your library</span>
                            {% elif user.can_download() %}
                                <button class="btn btn-primary btn-sm"
                                        hx-post="{{ base_url }}/book/{{ book.asin }}/hx-auto-download"
                                        hx-disabled-elt="this"
                                        hx-swap="none">
                                    <icons.Download />
                                    Auto Download
                                </button>
                            {% endif %}
                            <a preload class="btn btn-sm" href="{{ base_url }}/book/{{ book.asin }}">
                                Details
                            </a>
                        </div>
                    </div>
                </div>
                <div class="absolute left-3 right-3 top-1/2 hidden sm:flex -translate-y-1/2 transform justify-between pointer-events-none">
                    <button class="btn btn-circle btn-sm pointer-events-auto opacity-60 hover:opacity-100"
                            onclick="heroGo({{ loop.index0 - 1 }})">
                        ❮
                    </button>
                    <button class="btn btn-circle btn-sm pointer-events-auto opacity-60 hover:opacity-100"
                            onclick="heroGo({{ loop.index0 + 1 }})">
                        ❯
                    </button>
                </div>
            </div>
        {% endfor %}
    </div>
    <div class="flex justify-center gap-2 pt-2">
        {% for _ in slides %}
            <button class="hero-dot w-2 h-2 rounded-full bg-base-content/20 transition-colors"
                    onclick="heroGo({{ loop.index0 }})">
            </button>
        {% endfor %}
    </div>
    <script>
        (() => {
            const carousel = document.getElementById("hero-carousel");
            if (!carousel || carousel.dataset.init) return;
            carousel.dataset.init = "1";
            const count = carousel.children.length;
            let current = 0;
            let paused = false;
            const dots = () => document.querySelectorAll(".hero-dot");
            const paint = () => dots().forEach((d, i) =>
                d.classList.toggle("bg-primary", i === current));
            window.heroGo = (i) => {
                current = ((i % count) + count) % count;
                carousel.scrollTo({
                    left: carousel.clientWidth * current,
                    behavior: "smooth"
                });
                paint();
            };
            carousel.addEventListener("mouseenter", () => paused = true);
            carousel.addEventListener("mouseleave", () => paused = false);
            carousel.addEventListener("scroll", () => {
                const i = Math.round(carousel.scrollLeft / carousel.clientWidth);
                if (i !== current) {
                    current = i;
                    paint();
                }
            }, {
                passive: true
            });
            setInterval(() => {
                if (!paused && count > 1) window.heroGo(current + 1);
            }, 7000);
            paint();
        })();
    </script>
</div>

{#def
    results: list[AudiobookWishlistResult],
    user: DetailedUser,
    page: str,
    counts: WishlistCounts,
    update_tablist = False, # performs oob replacement for the tablist
    sort_by: str = "added",
    requested_by: str = "",
    usernames: list[str] = [],
#}

{% set active_downloads = results | selectattr("queue") | map(attribute="queue") | selectattr("state.is_active") | list %}
<div id="book-table-body"
     {% if active_downloads %}hx-get="{{ base_url }}/wishlist/hx-poll?page={{ page }}&sort_by={{ sort_by }}&requested_by={{ requested_by }}" hx-trigger="every 5s" hx-swap="outerHTML"{% endif %}>
    {% if update_tablist %}
        <Wishlist.Tablist page={{ page }} counts={{ counts }} />
    {% endif %}

    <WishlistFilterBar page={{ page }} user={{ user }} sort_by={{ sort_by }} requested_by={{ requested_by }} usernames={{ usernames }} endpoint="/wishlist/hx-poll?page={{ page }}" bulk={{ True }} />

    {% if not results %}
        <div role="alert" class="alert my-2">
            <span class="stroke-info h-6 w-6 shrink-0">
                <icons.InfoCircle />
            </span>
            <span>
                {% if page.__eq__("wishlist") %}
                    No books on your wishlist. Add some books by searching above {%
                    elif page.__eq__("downloaded") %} No books have been downloaded yet. {%
                    endif %}
                </span>
            </div>
        {% endif %}

        <!-- Desktop: full table -->
        <div class="hidden md:block">
            <table class="table table-pin-rows min-w-240 w-full">
                <thead>
                    <tr>
                        <th>
                        </th>
                        <th>
                        </th>
                        <th>
                            Title
                        </th>
                        <th>
                            Author
                        </th>
                        <th>
                            Narrator
                        </th>
                        <th>
                            Release
                        </th>
                        <th>
                            Length (hrs)
                        </th>
                        <th>
                            # Requested
                        </th>
                        <th>
                            Status
                        </th>
                        <th>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    {% for result in results %}
                        {% set book = result.book %}
                        <tr class="text-xs lg:text-sm" id="{{ book.asin }}">
                            <th>
                                <label class="flex flex-col items-center gap-1">
                                    {{ loop.index }}
                                    <input type="checkbox"
                                           name="sel_asin"
                                           value="{{ book.asin }}"
                                           class="checkbox checkbox-sm bulk-check" />
                                </label>
                            </th>
                            <td>
                                <a preload
                                   href="{{ base_url }}/book/{{ book.asin }}"
                                   class="block size-16 lg:size-24">
                                    {% if book.cover_image %}
                                        <img class="object-cover w-full h-full"
                                             height="64"
                                             width="64"
                                             src="{{ book.cover_image }}"
                                             alt="{{ book.title }}" />
                                    {% else %}
                                        <div class="flex items-center justify-center w-full h-full bg-neutral opacity-30">
                                            <icons.PhotoOff />
                                        </div>
                                    {% endif %}
                                </a>
                            </td>
                            <td>
                                <div class="flex flex-col">
                                    <a preload
                                       href="{{ base_url }}/book/{{ book.asin }}"
                                       class="font-bold text-primary line-clamp-4"
                                       title="{{ book.title }}">{{ book.title }}</a>
                                    {% if book.subtitle %}
                                        <span class="font-semibold line-clamp-4" title="{{ book.subtitle }}">{{ book.subtitle }}</span>
                                    {% endif %}
                                </div>
                            </td>
                            <td>
                                {{ book.authors|join(", ") }}
                            </td>
                            <td>
                                {{ book.narrators|join(", ") }}
                            </td>
                            <td class="hidden lg:table-cell">
                                {{ book.release_date.strftime("%B %Y") }}
                            </td>
                            <td class="lg:hidden">
                                {{ book.release_date.strftime("%Y") }}
                            </td>
                            <td>
                                {{ book.runtime_length_hrs }}
                            </td>
                            <td title="{{ result.amount_requested }}">
                                {% if user.is_admin() %}
                                    <button class="btn px-1 text-sm"
                                            onclick="requesters{{ loop.index }}.showModal()">
                                        {{ result.amount_requested }}
                                        <icons.Users />
                                    </button>
                                    <dialog id="requesters{{ loop.index }}" class="modal">
                                        <div class="modal-box">
                                            <h3 class="text-lg font-bold">
                                                Users that requested:
                                                <span class="italic">{{ book.title }}</span>
                                            </h3>
                                            <ul class="py-4 text-sm max-h-60 overflow-y-auto truncate list-disc list-inside">
                                                {% for req in result.requests %}
                                                    <li>
                                                        {{ req.user_username }}
                                                    </li>
                                                {% endfor %}
                                            </ul>
                                        </div>
                                        <form method="dialog" class="modal-backdrop">
                                            <button>
                                                close
                                            </button>
                                        </form>
                                    </dialog>
                                {% else %}
                                    {{ result.amount_requested }}
                                {% endif %}
                            </td>
                            <td class="min-w-24">
                                <BookStatusBadge downloaded={{ book.downloaded }} missing={{ book.missing }} queue={{ result.queue }} requesters={{ result.requests | map(attribute="user_username") | join(", ") }} />
                            </td>
                            <td>
                                <div class="grid grid-cols-2 min-w-32 gap-1 w-fit ml-auto">
                                    <a preload
                                       title="Torrent Sources"
                                       href="{{ base_url }}/wishlist/sources/{{ book.asin }}"
                                       {% if not user.is_admin() %}disabled{% endif %}
                                       class="btn btn-square">
                                        <icons.List />
                                    </a>
                                    <button {% if book.downloaded %}title="Downloaded"class="btn btn-square btn-ghost bg-success text-neutral/20" {% else %} title="Automatic Download" class="btn btn-square" {% endif %}
                                            {% if not user.can_download() or book.downloaded or (result.queue and result.queue.state.is_active) %}disabled{% endif %}
                                            hx-post="{{ base_url }}/wishlist/hx-auto-download/{{ book.asin }}"
                                            hx-swap="outerHTML"
                                            hx-target="#book-table-body"
                                            hx-disabled-elt="this">
                                        <icons.Download />
                                    </button>
                                    <button title="Remove"
                                            class="btn btn-square"
                                            hx-delete="{{ base_url }}/wishlist/hx-delete/{{ book.asin }}{%- if page.__eq__('downloaded') -%}?downloaded=true{%- endif -%}" {% if page.__eq__("downloaded") %}hx-confirm="Remove this book AND delete its files from the library?"{% endif %} hx-swap="
                                            outerHTML
                                            "
                                            hx-target="#book-table-body"
                                            hx-disabled-elt="this">
                                        <icons.Ban />
                                    </button>
                                    {% if book.downloaded %}
                                        <button class="btn btn-square btn-ghost bg-success text-neutral/20"
                                                disabled
                                                title="Set as downloaded">
                                            <icons.Checkmark />
                                        </button>
                                    {% else %}
                                        <button class="btn btn-square"
                                                title="Set as downloaded"
                                                hx-patch="{{ base_url }}/wishlist/downloaded/hx-add/{{ book.asin }}"
                                                {% if not user.is_admin() %}disabled{% endif %}
                                                hx-swap="outerHTML"
                                                hx-target="#book-table-body"
                                                hx-disabled-elt="this">
                                            <icons.Checkmark />
                                        </button>
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <!-- Mobile: compact card list -->
        <div class="md:hidden flex flex-col divide-y divide-base-200">
            {% for result in results %}
                {% set book = result.book %}
                <div class="flex gap-2 py-3 items-start" id="m-{{ book.asin }}">
                    <input type="checkbox"
                           name="sel_asin"
                           value="{{ book.asin }}"
                           class="checkbox checkbox-sm bulk-check mt-8" />
                    <a preload
                       href="{{ base_url }}/book/{{ book.asin }}"
                       class="block size-20 shrink-0 rounded overflow-hidden">
                        {% if book.cover_image %}
                            <img class="object-cover w-full h-full"
                                 height="80"
                                 width="80"
                                 src="{{ book.cover_image }}"
                                 alt="{{ book.title }}" />
                        {% else %}
                            <div class="flex items-center justify-center w-full h-full bg-neutral opacity-30">
                                <icons.PhotoOff />
                            </div>
                        {% endif %}
                    </a>
                    <div class="flex flex-col gap-1 min-w-0 flex-1">
                        <a preload
                           href="{{ base_url }}/book/{{ book.asin }}"
                           class="font-bold text-primary text-sm line-clamp-2"
                           title="{{ book.title }}">{{ book.title }}</a>
                        <span class="text-xs opacity-60 truncate">{{ book.authors|join(", ") }} · {{ book.release_date.strftime("%Y") }} · {{ book.runtime_length_hrs }}h</span>
                        <div class="pt-1">
                            <BookStatusBadge downloaded={{ book.downloaded }} missing={{ book.missing }} queue={{ result.queue }} requesters={{ result.requests | map(attribute="user_username") | join(", ") }} />
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-1 w-fit h-fit shrink-0">
                        <button {% if book.downloaded %}title="Downloaded"class="btn btn-square btn-sm btn-ghost bg-success text-neutral/20" {% else %} title="Automatic Download" class="btn btn-square btn-sm" {% endif %}
                                {% if not user.can_download() or book.downloaded or (result.queue and result.queue.state.is_active) %}disabled{% endif %}
                                hx-post="{{ base_url }}/wishlist/hx-auto-download/{{ book.asin }}"
                                hx-swap="outerHTML"
                                hx-target="#book-table-body"
                                hx-disabled-elt="this">
                            <icons.Download />
                        </button>
                        <a preload
                           title="Torrent Sources"
                           href="{{ base_url }}/wishlist/sources/{{ book.asin }}"
                           {% if not user.is_admin() %}disabled{% endif %}
                           class="btn btn-square btn-sm">
                            <icons.List />
                        </a>
                        <button title="Remove"
                                class="btn btn-square btn-sm"
                                hx-delete="{{ base_url }}/wishlist/hx-delete/{{ book.asin }}{%- if page.__eq__('downloaded') -%}?downloaded=true{%- endif -%}" {% if page.__eq__("downloaded") %}hx-confirm="Remove this book AND delete its files from the library?"{% endif %} hx-swap="
                                outerHTML
                                "
                                hx-target="#book-table-body"
                                hx-disabled-elt="this">
                            <icons.Ban />
                        </button>
                        {% if book.downloaded %}
                            <button class="btn btn-square btn-sm btn-ghost bg-success text-neutral/20"
                                    disabled
                                    title="Set as downloaded">
                                <icons.Checkmark />
                            </button>
                        {% else %}
                            <button class="btn btn-square btn-sm"
                                    title="Set as downloaded"
                                    hx-patch="{{ base_url }}/wishlist/downloaded/hx-add/{{ book.asin }}"
                                    {% if not user.is_admin() %}disabled{% endif %}
                                    hx-swap="outerHTML"
                                    hx-target="#book-table-body"
                                    hx-disabled-elt="this">
                                <icons.Checkmark />
                            </button>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

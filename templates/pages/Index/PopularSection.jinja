{#def
    title: str = "",
    user: DetailedUser,
    region: audible_region_type,
    view_more: str | None = None,
    lazy_url: str | None = None,
    description: str | None = None,
    empty: str | None = None,
    auto_start_download: bool = False,
    reasons: list = [],
#}

{% if lazy_url %}
    <div class="w-full max-w-7xl"
         hx-get="{{ base_url }}{{ lazy_url }}"
         hx-trigger="load"
         hx-swap="outerHTML">
    </div>
{% elif reasons %}
    <div class="w-full max-w-7xl mb-8">
        <div class="flex justify-between items-center mb-4">
            <div>
                <h2 class="text-2xl font-bold">
                    {{ title }}
                </h2>
                {% if description %}
                    <p class="text-sm opacity-70">
                        {{ description }}
                    </p>
                {% endif %}
            </div>
            {% if view_more %}
                <a href="{{ base_url }}{{ view_more }}" class="link link-primary">Discover more →</a>
            {% endif %}
        </div>
        <div class="overflow-x-auto">
            <div class="flex gap-4 pb-4" style="width: max-content">
                {% for reason in reasons[:16] %}
                    <div class="flex-none w-32 sm:w-40">
                        <BookCard book_with_requests={{ reason.book }} auto_start_download={{ auto_start_download }} region={{ region }} user={{ user }} />
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endif %}

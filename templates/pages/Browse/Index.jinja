{#def
    user: DetailedUser,
    categories: list[BrowseCategory],
    sorts: list,
    region: audible_region_type,
    category_id: str = "",
    sort: str = "Relevance",
    keywords: str = "",
    auto_start_download: bool = False,
#}

<BaseLayout title="Browse" user={{ user }}>

<div class="w-screen flex flex-col items-center justify-center p-6 sm:p-8 overflow-x-hidden gap-4">
    <div class="w-full max-w-7xl flex flex-col gap-4">
        <h1 class="text-3xl font-bold">
            Browse
        </h1>
        <div id="browse-bar" class="flex flex-wrap items-center gap-2">
            <select name="category_id"
                    class="select select-sm w-64"
                    title="Genre"
                    hx-get="{{ base_url }}/browse/hx-results"
                    hx-include="#browse-bar select, #browse-bar input"
                    hx-target="#browse-results"
                    hx-swap="innerHTML">
                <option value="">
                    All genres
                </option>
                {% for cat in categories %}
                    <option value="{{ cat.id }}"
                            {% if category_id.__eq__(cat.id) %}selected{% endif %}>
                        {{ cat.name }}
                    </option>
                {% endfor %}
            </select>
            <select name="sort"
                    class="select select-sm w-40"
                    title="Sort"
                    hx-get="{{ base_url }}/browse/hx-results"
                    hx-include="#browse-bar select, #browse-bar input"
                    hx-target="#browse-results"
                    hx-swap="innerHTML">
                {% for value, label in sorts %}
                    <option value="{{ value }}" {% if sort.__eq__(value) %}selected{% endif %}>
                        {{ label }}
                    </option>
                {% endfor %}
            </select>
            <input name="q"
                   type="search"
                   placeholder="Filter by keywords…"
                   value="{{ keywords }}"
                   autocomplete="off"
                   class="input input-sm w-48"
                   hx-get="{{ base_url }}/browse/hx-results"
                   hx-include="#browse-bar select, #browse-bar input"
                   hx-trigger="input changed delay:400ms, search"
                   hx-target="#browse-results"
                   hx-swap="innerHTML" />
        </div>
        <div id="browse-results"
             hx-get="{{ base_url }}/browse/hx-results?category_id={{ category_id }}&sort={{ sort }}&q={{ keywords }}"
             hx-trigger="load"
             hx-swap="innerHTML">
            <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-6 gap-4">
                {% for _ in range(12) %}
                    <div class="w-full aspect-square rounded-md bg-base-200 animate-pulse">
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</div>

</BaseLayout>
